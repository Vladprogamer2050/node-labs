{
  "name": "lab17-cli",
  "version": "1.0.0",
  "description": "Laboratory work 17: CLI application with commander, inquirer, chalk, ora and cli-progress",
  "license": "MIT",
  "author": "Evdokimov Vladislav Evgenievich, group 478",
  "bin": {
    "lab17-cli": "bin/lab17-cli.js"
  },
  "main": "bin/lab17-cli.js",
  "files": [
    "bin",
    "commands",
    "services",
    "utils",
    "config.js"
  ],
  "scripts": {
    "start": "node bin/lab17-cli.js",
    "test": "jest --runInBand",
    "build:binary": "pkg . --targets node22.23.4-win-x64 --output bin/lab17-cli.exe"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "4.1.2",
    "cli-progress": "3.12.0",
    "commander": "12.1.0",
    "inquirer": "8.2.6",
    "ora": "5.4.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.25.0",
    "jest": "29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "services/**/*.js",
      "utils/**/*.js"
    ]
  },
  "pkg": {
    "scripts": [
      "bin/**/*.js",
      "commands/**/*.js",
      "services/**/*.js",
      "utils/**/*.js",
      "config.js"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "nodejs",
    "cli",
    "commander",
    "inquirer",
    "laboratory"
  ]
}
